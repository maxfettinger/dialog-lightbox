{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110
  },
  "linter": {
    "rules": {
      "style": {
        "noNonNullAssertion": "off"
      }
    }
  },
  "files": {
    "includes": [
      "**",
      "!test/browser/media",
      "!demo/layouts",
      "!demo/public",
      "!demo/static/lib",
      "!demo/resources",
      "!site"
    ]
  },
  "overrides": [
    {
      "includes": ["demo/**"],
      "linter": {
        "rules": {
          "a11y": {
            "noRedundantRoles": "off",
            "noNoninteractiveTabindex": "off"
          }
        }
      }
    }
  ]
}
